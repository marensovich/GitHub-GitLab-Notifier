# ============================================
# GitHub-GitLab Notifier — Configuration
# ============================================

# --- Telegram Bot ---

# Telegram bot token from @BotFather (required)
# Get it: https://t.me/BotFather
BOT_TOKEN=123456:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram bot username without @ (required)
TELEGRAM_BOT_USERNAME=YourGitBot

# Fallback Telegram chat ID (optional).
# Used only while no chat has been set up with /configure or /connect.
# Find it: send any message to the bot, then open
# https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
# and look for "chat":{"id":123456789}
CHAT_ID=123456789

# Default language for logs and new chats: en or ru (optional, default en).
# Each chat can switch its own language with /lang.
BOT_LANG=en

# --- Server ---

# Server listen address (0.0.0.0 = all interfaces, 127.0.0.1 = localhost only)
SERVER_ADDRESS=0.0.0.0

# Server port for receiving webhooks from GitHub/GitLab
SERVER_PORT=8080

# --- Proxy (optional, for countries where Telegram is blocked) ---

# Enable proxy for Telegram API connections (true/false)
PROXY_ENABLED=false

# Proxy host (e.g., 127.0.0.1 for local proxy)
PROXY_HOST=127.0.0.1

# Proxy port (e.g., 1080 for SOCKS5, 8080 for HTTP)
PROXY_PORT=1080

# Proxy type: HTTP or SOCKS
PROXY_TYPE=HTTP

# --- Webhook URL ---

# Your server's public domain or IP address
# Used to generate webhook URL for GitHub/GitLab
# Examples: mybot.example.com, 1.2.3.4
DOMAIN=mybot.example.com

# Use HTTPS for webhook URL (true/false)
# Set to true if you have SSL/TLS certificate configured (recommended)
# Set to false for local development without HTTPS
USE_HTTPS=true

# --- Security ---

# Global webhook secret (optional, recommended).
# When set, every webhook must be signed with it:
#   GitHub: put it into the "Secret" field of the webhook
#   GitLab: put it into the "Secret token" field of the webhook
# Per-repository secrets shown by /connect are always accepted as well.
WEBHOOK_SECRET=

# --- Advanced ---

# Path to the SQLite database file (default data/notifier.db)
DB_PATH=data/notifier.db

# Send a generic message for webhook events the bot does not support yet
# (e.g. check_suite, deployment). Default false: such events are ignored.
NOTIFY_UNKNOWN_EVENTS=false
