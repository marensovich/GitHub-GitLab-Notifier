# A 1.1 .env as install.sh wrote it, with every variable set.
BOT_TOKEN=123456:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_USERNAME=YourGitBot
CHAT_ID=-1001234567890
BOT_LANG=ru

SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8443

PANEL_ADDRESS=127.0.0.1:8081
PANEL_ALLOW_REMOTE=false

PROXY_ENABLED=true
PROXY_HOST=127.0.0.1
PROXY_PORT=1080
PROXY_TYPE=SOCKS

TELEGRAM_API_URL=
DOMAIN=https://notify.example.com/
USE_HTTPS=true

# A secret with a dollar sign must survive ${VAR} expansion.
export WEBHOOK_SECRET="pa$$word"

DB_PATH=/var/lib/notifier/notifier.db
NOTIFY_UNKNOWN_EVENTS=true
RICH_MESSAGES=false
DELIVERIES_RETENTION_DAYS=30
METRICS_ENABLED=true
METRICS_ADDR='127.0.0.1:9090'
